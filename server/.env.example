# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL 8.x Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=teachspace_db

# Security Secrets (Ganti dengan string acak panjang di production)
JWT_SECRET=replace_with_strong_random_jwt_secret_key_min_32_chars
CSRF_SECRET=replace_with_strong_random_csrf_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
